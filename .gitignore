# Python
__pycache__/
*.pyc
.venv/
venv/

# Local secrets -- NEVER commit these. Real tokens live in GitHub Secrets.
.env
*.env

# OS junk
.DS_Store
Thumbs.db

# Local git worktrees used for isolated feature work
.worktrees/

# NOTE: we intentionally DO commit:
#   3 Photos/                  (source photos the owner drops in each week)
#   2 Posters and Flyers/      (finished posters and social graphics)
#   Claude Files - Do Not Touch/fonts/   (so fonts aren't re-downloaded every run)
#   posts.csv, status.log      (the system's state + your visible log)

# Marker file setup.sh drops in a copied skill install
.installed-by-backyard-brew-setup

# Backups of .docx files replaced when a sheet changed
Claude Files - Do Not Touch/playbook/editable/_previous/

# Scratch previews generated by /photos when reading HEIC files
_previews/

# Dispute/incident evidence -- private, not part of the public content pipeline
incident-records/
Claude Files - Do Not Touch/poster-work/**/sunday-market-and-brews-poster.html
Claude Files - Do Not Touch/poster-work/**/_preview_*.html

# Claude's knowledge graph -- rebuilt locally, never synced
graphify-out/
