# Python
__pycache__/
*.pyc
.venv/
venv/

# Local secrets -- NEVER commit these. Real tokens live in GitHub Secrets.
.env
*.env

# OS junk
.DS_Store
Thumbs.db

# Local git worktrees used for isolated feature work
.worktrees/

# NOTE: we intentionally DO commit:
#   photos/            (source photos the owner drops in each week)
#   photos/_generated/ (the finished flyer images used for manual posting)
#   assets/fonts/      (so fonts aren't re-downloaded every run)
#   posts.csv, status.log (the system's state + your visible log)

# Marker file setup.sh drops in a copied skill install
.installed-by-backyard-brew-setup

# Backups of .docx files replaced when a sheet changed
playbook/editable/_previous/

# Scratch previews generated by /photos when reading HEIC files
_previews/
